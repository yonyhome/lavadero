rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos de usuarios
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if true; // En producción, agregar validación
    }

    // Fotos de trabajadores (solo admin)
    match /workers/{workerId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Fotos de servicios (solo admin)
    match /services/{serviceId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
