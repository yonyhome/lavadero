rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: lectura pública, escritura autenticada o anónima
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.auth != null || resource.data.plate == userId;
    }

    // Orders: lectura pública, crear cualquiera, actualizar según condiciones
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.resource.data.status == 'cancelled'
                    || (request.auth != null && request.auth.token.admin == true)
                    || (
                        resource.data.status == 'completed'
                        && resource.data.rated == false
                        && request.resource.data.rated == true
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['rating', 'rated', 'updatedAt', 'skippedRating', 'ratingSkippedAt'])
                       );
    }

    // Services: lectura pública, escritura admin
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Workers: lectura pública (necesario para login de trabajadores), escritura solo admin
    match /workers/{workerId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Settings: lectura pública, escritura admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // MotorcycleModels: lectura pública, escritura admin
    match /motorcycleModels/{modelId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Notifications: solo admin
    match /notifications/{notifId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // Reports: escritura por Cloud Functions, lectura pública
    match /dailyReports/{reportId} {
      allow read: if true;
      allow write: if true;
    }

    match /monthlyReports/{reportId} {
      allow read: if true;
      allow write: if true;
    }

    // Admins
    match /admins/{adminId} {
      allow read, write: if request.auth != null && request.auth.uid == adminId && request.auth.token.admin == true;
    }
  }
}
